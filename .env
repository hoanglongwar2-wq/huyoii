# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env lên GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Tài khoản admin (là bạn). Mật khẩu từ 8 ký tự; đổi giá trị này là đổi mật khẩu admin.
ADMIN_EMAIL=ban@example.com
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập (vd: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Tùy chọn
# DB_PATH=data/huy_ai.db
# USER_QUOTA_MB=300
# ALLOW_REGISTER=1
# CORS_ORIGINS=

# Nhiều key Gemini cách nhau dấu phẩy: key lỗi/hết hạn mức sẽ tự chuyển key kế tiếp
# GEMINI_API_KEYS=
# Đăng nhập Google / Facebook (tùy chọn)
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Bạn cũng có thể điền tất cả trong config.py
